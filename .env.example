# Copia este archivo como ".env" y llena los valores. El archivo .env nunca se sube al repositorio.

# Cadena de conexión de PostgreSQL (Supabase > Connect > Session pooler).
# Sin esta variable el juego funciona en modo invitado: sin cuentas ni progreso guardado.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Certificado de Supabase para verificar la conexión cifrada
# (Supabase > Database > Settings > SSL Configuration > Download certificate).
DATABASE_CA_FILE=./prod-ca-2021.crt

# Alternativa: pegar aquí el contenido del certificado en vez de usar un archivo
# DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Solo para una base PostgreSQL local sin cifrado:
# DATABASE_SSL=off

# Clave para firmar las sesiones: al menos 32 caracteres aleatorios.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas

PORT=3000

# ---------- Solo en el servidor publicado ----------
# NODE_ENV=production   activa HSTS, exige JWT_SECRET larga y lee la IP real detrás del proxy
# TRUST_PROXY=1         proxies delante del servidor (1 en Render/Railway/Fly; 0 en tu PC)
# CORS_ORIGIN=https://otro-dominio.com   solo si el cliente se publica en otro dominio
# MAX_ROOMS=100         salas abiertas a la vez
# MAX_CONNECTIONS_PER_IP=10

# Solo para desarrollo: fuerza un evento desde la ronda indicada (eclipse, meteoros, cazador, cofre, escolta).
# ER_FIRST_EVENT_ROUND=1
# ER_FORCE_EVENT=escolta
